    "dislikes": {"type": "array", "items": {"type": "string"}},
    "major_risks": {"type": "array", "items": {"type": "string"}},
    "conflicting_or_missing_evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
